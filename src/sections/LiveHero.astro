---
import StreamPlayer from '../components/StreamPlayer.astro';
import SchedulePanel from '../components/SchedulePanel.astro';
import type { Session } from '../lib/agenda';
interface Props { live?: Session; now: Session[]; upcoming: Session[]; past: Session[]; eventOver: boolean }
const { live, now, upcoming, past, eventOver } = Astro.props;
---
<section data-hero class="mx-auto w-[min(1280px,calc(100%-2rem))] pb-16 pt-10 sm:pt-14">
  <div class="flex flex-col items-center gap-6 text-center">
    <div>
      <h1 data-anim="title" class="text-5xl font-extrabold leading-none sm:text-7xl">GPS <span class="text-brand">LIVE</span></h1>
      <p data-anim="tagline" class="mt-3 text-sm tracking-[4px] text-white/80 sm:text-lg sm:tracking-[6px]">PEOPLE. IDEAS. TECHNOLOGY. REAL IMPACT.</p>
    </div>
    <div data-anim="meta" class="flex flex-col items-center gap-1">
      <p class="text-xl font-medium">25 – 26 OCT 2026</p>
      <p class="text-xs tracking-widest text-white/70">RIYADH, SAUDI ARABIA</p>
      <p class="mt-2 text-xs tracking-[5px] text-brand">SCALING INTELLIGENCE</p>
    </div>
  </div>
  <div class="mt-8 grid gap-5 lg:grid-cols-[minmax(0,1fr)_380px]">
    <StreamPlayer live={live} next={upcoming[0]} hasPast={past.length > 0} eventOver={eventOver} />
    <div class="relative">
      <SchedulePanel now={now} upcoming={upcoming} past={past} />
    </div>
  </div>
</section>
<script>
  import { init } from '../animations/hero';

  let cleanup: (() => void) | undefined;
  const start = () => {
    cleanup?.();
    const root = document.querySelector<HTMLElement>('[data-hero]');
    if (root) cleanup = init(root);
  };
  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', () => cleanup?.());
</script>
