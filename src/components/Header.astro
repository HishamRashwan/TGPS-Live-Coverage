---
const MAIN = 'https://www.globalproptechsummit.com';
---
<header class="sticky top-4 z-30 mx-auto w-[min(1280px,calc(100%-2rem))]">
  <nav class="glass flex items-center justify-between gap-3 !rounded-full px-4 py-3 sm:gap-4 sm:px-5" aria-label="Main">
    <a href={MAIN} aria-label="Global PropTech Summit home" class="shrink-0">
      <img src="/brand/logo.png" alt="Global PropTech Summit" width="790" height="119" class="h-5 w-auto max-w-none object-contain min-[360px]:h-6 sm:h-8" />
    </a>
    <a href={`${MAIN}/register`} class="shrink-0 rounded-full bg-brand px-4 py-2 text-xs font-bold sm:px-6 sm:py-2.5 sm:text-sm text-white transition hover:brightness-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">REGISTER</a>
  </nav>
</header>
